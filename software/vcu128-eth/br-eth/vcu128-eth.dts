// Device tree for the VCU128 RocketVCU128EthernetConfig design: the chip's generated device tree plus the AXI
// 1G Ethernet and its AXI DMA, which live in the FPGA harness (fpga/src/main/scala/vcu128/Ethernet.scala) and so are
// not in the chip's own device tree. Nodes are referenced by path because the generated labels change between
// builds. PHY settings are those of the working VCU128 MicroBlaze example (example_ethernet, system-user.dtsi).

/include/ "chipyard.fpga.vcu128.VCU128FPGATestHarness.RocketVCU128EthernetConfig.dts"

&{/soc/mmio-port-axi4@60000000} {
	eth0: ethernet@60000000 {
		compatible = "xlnx,axi-ethernet-1.00.a";
		// Ethernet core registers, then the DMA's (the driver uses the DMA directly, without "dmas")
		reg = <0x60000000 0x40000>, <0x60100000 0x10000>;
		// Chip external interrupts 0/1/2 = PLIC sources 1/2/3: DMA TX, DMA RX, Ethernet core
		interrupt-parent = <&{/soc/interrupt-controller@c000000}>;
		interrupts = <1>, <2>, <3>;
		// The register interface runs on the 50 MHz bus clock; the driver derives the MDIO clock from it
		clocks = <&{/soc/sbus_clock}>;
		clock-names = "s_axi_lite_clk";
		phy-mode = "sgmii";
		// SGMII autonegotiation between the core's PCS/PMA and the DP83867. Without this, phylink configures the
		// PCS out-of-band (autonegotiation off) while the PHY keeps SGMII autonegotiation on, so the PHY never
		// passes frames to the FPGA: the copper link comes up but nothing is received.
		managed = "in-band-status";
		phy-handle = <&phy0>;
		pcs-handle = <&pcs_phy>;
		xlnx,rxmem = <0x1000>;
		xlnx,txcsum = <0x0>;
		xlnx,rxcsum = <0x0>;
		// Placeholder, locally administered (Xilinx OUI with the local bit set). The board's real address goes in
		// the git-ignored file mac-address; host-init.sh writes it into local-mac.dtsi, included below.
		local-mac-address = [02 0a 35 00 00 01];

		mdio {
			#address-cells = <1>;
			#size-cells = <0>;

			// TI DP83867 on the VCU128
			phy0: ethernet-phy@3 {
				reg = <3>;
				ti,sgmii-ref-clock-output-enable;
				ti,dp83867-rxctrl-strap-quirk;
				ti,rx-internal-delay = <0x8>;
				ti,tx-internal-delay = <0xa>;
				ti,fifo-depth = <0x1>;
			};

			// The core's internal 1G PCS/PMA (PHYADDR 1 in the IP settings)
			pcs_phy: ethernet-phy@1 {
				compatible = "ethernet-phy-id0174.0c00";
				reg = <1>;
			};
		};
	};
};

// Generated by host-init.sh from the git-ignored file mac-address (overrides local-mac-address above)
/include/ "local-mac.dtsi"
